{"success":true,"code":null,"message":null,"requestId":"Tf1c0bb65cc09464da0f74c41cba2f700","data":{"contentData":{"id":"RAW_eb89e83b","displayDocument":"<html>\n <head></head>\n <body>\n  <div style=\"margin-left: 6px;margin-right: 6px;line-height: 1.75em;\">\n   <p style=\"text-align: center;\"><img class=\"rich_pages wxw-img\" type=\"block\" style=\"width:100%;\" src=\"https://wechat2rss.bestblogs.dev/img-proxy/?k=637f6842&amp;u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_jpg%2FkN3t5R6pdz6S5iadt18XIULMgpTDYmHA527r6dacKd4pWQXgSlTLPJgvib0ibMY1Libial9V6DEIdvf07AMTEdTJcQlovAYgcFPUNEVH59QxZMec%2F640%3Fwx_fmt%3Djpeg\"></p>\n   <p class=\"js_darkmode__0\" style=\"font-variant-caps:normal;white-space:normal;font-weight:400;font-size:17px;min-height:1em;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;text-align:center;-webkit-text-stroke-width:0px;padding:0px;margin:24px 8px 0px;visibility:visible;letter-spacing:0.544px;clear:both;text-decoration-style:initial;line-height:1.8;font-style:normal;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\"><span style=\"-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin-right: 0px;margin-bottom: 0px;margin-left: 0px;padding: 0px;outline: 0px;max-width: 100%;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;\"><span style=\"color: rgb(234, 120, 0);font-weight: bold;\">这是2026年的第</span><span style=\"font-weight:bold;font-size:20px;\">27</span><span style=\"color: rgb(234, 120, 0);font-weight: bold;\">篇文章</span></span></p>\n   <p class=\"js_darkmode__2\" style=\"font-variant-caps:normal;white-space:normal;font-weight:400;font-size:17px;min-height:1em;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;text-align:center;-webkit-text-stroke-width:0px;padding:0px;margin:0px 8px;visibility:visible;letter-spacing:0.544px;clear:both;text-decoration-style:initial;line-height:1.8;font-style:normal;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\"><span style=\"-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin-top: 0px;margin-right: 0px;margin-left: 0px;padding: 0px;outline: 0px;max-width: 100%;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;\"><span style=\"font-size: 14px;color: rgb(234, 120, 0);\">（ 本文阅读时间：约20分钟 ）</span></span></p>\n  </div>\n  <div style=\"margin-left: 6px;margin-right: 6px;line-height: 1.75em;\">\n   <h1 class=\"js_darkmode__3\" style=\"font-variant-caps:normal;color:rgb(234, 120, 0);white-space:normal;font-weight:500;font-size:20px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;text-align:center;-webkit-text-stroke-width:0px;padding:0px;margin:0px 8px 24px;visibility:visible;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.8;font-style:normal;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\"><span class=\"js_darkmode__4\" style=\"font-variant-caps:normal;color:rgb(234, 120, 0);font-weight:500;font-size:20px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);margin-left:0px;outline:0px;word-spacing:0px;text-indent:0px;margin-top:0px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;-webkit-text-stroke-width:0px;padding:0px;visibility:visible;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.8;font-style:normal;margin-right:0px;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\">前言</span></h1>\n   <p style=\"margin:0px 0px 24px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">OpenSandbox 是一个阿里巴巴开源的面向 AI Agent 的通用沙箱平台，提供多语言 SDK、CLI、MCP Server，以及 Docker / Kubernetes 运行时，在阿里内部广泛应用于 Coding Agent、GUI Agent、代码执行、Agent 评测、RL 训练等场景。</span></p>\n   <p style=\"margin:24px 0px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">OpenSandbox 正在成为 AI Agent 基础设施领域里一个重要的开源项目。<span style=\"font-weight: bold;\">随着 AI Agent 从 Demo 走向生产环境，沙箱要解决的问题也不再只是“代码在哪里执行”，还包括“真实凭据应该如何安全使用”。</span></span></p>\n   <p style=\"margin:24px 0px 0px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">这就是 Credential Vault 要解决的问题：让工具照常工作，但让真实密钥不再进入沙箱。</span></p>\n   <p style=\"margin-left: 6px;margin-right: 6px;line-height: 1.75em;\"></p>\n   <h1 class=\"js_darkmode__3\" style=\"font-variant-caps:normal;color:rgb(234, 120, 0);white-space:normal;font-weight:500;font-size:20px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;text-align:center;-webkit-text-stroke-width:0px;padding:0px;margin:48px 8px 0px;visibility:visible;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.8;font-style:normal;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\"><span class=\"js_darkmode__4\" style=\"font-variant-caps:normal;color:rgb(234, 120, 0);font-weight:500;font-size:20px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);margin-left:0px;outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;-webkit-text-stroke-width:0px;padding:0px;visibility:visible;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.8;font-style:normal;margin-right:0px;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\">01</span></h1>\n   <p></p>\n   <p style=\"text-align: center;margin-top: 0px;margin-bottom: 24px;\"><span style=\"color:rgb(234, 120, 0);font-weight:500;letter-spacing:0.544px;font-size:20px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;font-style:normal;\">为什么不能直接把密钥放进沙箱</span></p>\n   <p style=\"margin:0px 0px 24px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">在过去，想让 Agent 在沙箱里调用外部服务，最直接的方式往往是把 API Key、Git Token、Registry 凭据等塞进环境变量、命令行参数或配置文件里。</span></p>\n   <p style=\"margin:24px 0px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">这种方式虽然简单，不过，风险也很直接：沙箱本来是用来隔离不可信代码和工具执行的，一旦真实密钥进入沙箱，Prompt Injection、恶意依赖、日志泄露、文件读取等风险都会被放大。</span></p>\n   <p style=\"text-align: center;\"><img class=\"rich_pages wxw-img js_insertlocalimg\" type=\"block\" style=\"width:100%;\" src=\"https://wechat2rss.bestblogs.dev/img-proxy/?k=8788de8d&amp;u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2FkN3t5R6pdz4Xncodm0WtiatpicKECTaoOeCM5H9ia85r0K405SRFYFibrMvmMSNnk6DcyHbPzkG90bHic4BYiaZweaz0dSEc9SAW8Ab7PaO8U1CsE%2F640%3Fwx_fmt%3Dpng%26from%3Dappmsg\"></p>\n   <p style=\"margin:24px 0px;font-size:15px;line-height:1.6em;\"><span style=\"\" src=\"\" align=\"\" alt=\"\" border=\"\" class=\"rich_pages wxw-img js_insertlocalimg\" aria-label=\"\" aria-braillelabel=\"\" aria-description=\"\" height=\"\" ismap opacity=\"\" sizes=\"\" title=\"\" type=\"block\" usemap=\"\" width=\"\">例如，一个 Coding Agent 可能需要：</span></p>\n   <ul style=\"margin: 1em 0;padding-left: 2em;\" class=\"list-paddingleft-1\">\n    <li style=\"margin-bottom: 0.4em;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\">调用模型 API；</span></p>\n    </li>\n    <li style=\"margin-bottom: 0.4em;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\">clone 私有 Git 仓库；</span></p>\n    </li>\n    <li style=\"margin-bottom: 0.4em;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\">安装私有包；</span></p>\n    </li>\n    <li style=\"margin-bottom: 0.4em;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\">用 curl 访问内部 API；</span></p>\n    </li>\n    <li style=\"margin-bottom: 0.4em;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\">运行第三方 CLI 或依赖脚本。</span></p>\n    </li>\n   </ul>\n   <p style=\"margin:24px 0px 48px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">这些操作都可能需要凭据。如果凭据直接暴露在沙箱环境变量、命令参数、配置文件或日志里，那么，只要沙箱内的任意工具链环节失控，真实密钥就可能被读取、打印或转发。</span></p>\n   <p style=\"margin-left: 6px;margin-right: 6px;line-height: 1.75em;\"></p>\n   <h1 class=\"js_darkmode__3\" style=\"font-variant-caps:normal;color:rgb(234, 120, 0);white-space:normal;font-weight:500;font-size:20px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;text-align:center;-webkit-text-stroke-width:0px;padding:0px;margin:48px 8px 0px;visibility:visible;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.8;font-style:normal;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\"><span class=\"js_darkmode__4\" style=\"font-variant-caps:normal;color:rgb(234, 120, 0);font-weight:500;font-size:20px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);margin-left:0px;outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;-webkit-text-stroke-width:0px;padding:0px;visibility:visible;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.8;font-style:normal;margin-right:0px;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\">02</span></h1>\n   <p></p>\n   <p style=\"text-align: center;margin-bottom: 24px;\"><span style=\"color:rgb(234, 120, 0);font-weight:500;letter-spacing:0.544px;font-size:20px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;font-style:normal;\">Credential Vault 的核心思路</span></p>\n   <p style=\"margin:24px 0px 0px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">Credential Vault 是 OpenSandbox 的出站凭据代理能力。它把真实凭据保存在沙箱外，由 OpenSandbox 的 egress sidecar 在出站请求经过时按规则注入认证信息。</span></p>\n   <p style=\"margin:24px 0px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">整体流程可以理解为：</span></p>\n   <ol style=\"margin: 1em 0;padding-left: 2em;\" class=\"list-paddingleft-1\">\n    <li style=\"margin-bottom:0.4em;color:#888888;font-size:14px;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span style=\"font-size: 14px;color: rgb(136, 136, 136);\">宿主侧 SDK 创建 sandbox，并启用 Credential Proxy；</span></span></p>\n    </li>\n    <li style=\"margin-bottom:0.4em;color:#888888;font-size:14px;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span style=\"font-size: 14px;color: rgb(136, 136, 136);\">SDK 将真实凭据和绑定规则写入 egress sidecar 的 Credential Vault；</span></span></p>\n    </li>\n    <li style=\"margin-bottom:0.4em;color:#888888;font-size:14px;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span style=\"font-size: 14px;color: rgb(136, 136, 136);\">沙箱进程只拿到假值或空值，例如一个假的 API Key；</span></span></p>\n    </li>\n    <li style=\"margin-bottom:0.4em;color:#888888;font-size:14px;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span style=\"font-size: 14px;color: rgb(136, 136, 136);\">当沙箱内工具发起 HTTPS 出站请求时，egress sidecar 检查请求的 scheme、host、port、method 和 path；</span></span></p>\n    </li>\n    <li style=\"margin-bottom:0.4em;color:#888888;font-size:14px;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span style=\"font-size: 14px;color: rgb(136, 136, 136);\">如果请求精确匹配某条 Credential Vault binding，sidecar 就在出站时注入对应的认证 Header；</span></span></p>\n    </li>\n    <li style=\"margin-bottom:0.4em;color:#888888;font-size:14px;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span style=\"font-size: 14px;color: rgb(136, 136, 136);\">真实凭据不会返回给沙箱，也不会出现在沙箱环境变量、命令行、文件系统和日志里。</span></span></p>\n    </li>\n   </ol>\n   <p style=\"text-align: center;\"><img class=\"rich_pages wxw-img js_insertlocalimg\" type=\"block\" style=\"width:100%;\" src=\"https://wechat2rss.bestblogs.dev/img-proxy/?k=28439ceb&amp;u=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_png%2FkN3t5R6pdz7klLt5n8JCzEg7GDAH3EzqmDFxEqaEcTTc4ozFKrMSWNqTzZaqDpQls2TVLFj04Uiaxe81OyAx6ICfGvGyeTTDmcW4ibYFY855M%2F640%3Fwx_fmt%3Dpng%26from%3Dappmsg\"></p>\n   <p style=\"margin:24px 0px 48px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">换句话说，沙箱仍然可以运行 Claude Code、Git、curl、包管理器或模型 API 客户端，但真实密钥不再交给这些工具所在的运行环境。</span></p>\n   <p style=\"margin-left: 6px;margin-right: 6px;line-height: 1.75em;\"></p>\n   <h1 class=\"js_darkmode__3\" style=\"font-variant-caps:normal;color:rgb(234, 120, 0);white-space:normal;font-weight:500;font-size:20px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);margin-left:8px;outline:0px;word-spacing:0px;text-indent:0px;margin-top:48px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;text-align:center;-webkit-text-stroke-width:0px;padding:0px;visibility:visible;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.8;font-style:normal;margin-right:8px;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\"><span class=\"js_darkmode__4\" style=\"font-variant-caps:normal;color:rgb(234, 120, 0);font-weight:500;font-size:20px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);margin-left:0px;outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;-webkit-text-stroke-width:0px;padding:0px;visibility:visible;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.8;font-style:normal;margin-right:0px;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\">03</span></h1>\n   <p></p>\n   <p style=\"margin-bottom: 24px;text-align: center;\"><span style=\"color:rgb(234, 120, 0);font-weight:500;letter-spacing:0.544px;font-size:20px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;font-style:normal;\">一个典型场景：沙箱内的 Claude Code 调用模型 API</span></p>\n   <p style=\"margin:0px 0px 24px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\"><span>我们以 Claude Code 调用 Anthropic API 为例。</span></span></p>\n   <p style=\"margin:0px 0px 24px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\"><span>传统做法通常是在沙箱里设置真实的&nbsp;</span><code style=\"font-family: monospace;\"><span><span>ANTHROPIC_API_KEY</span></span></code><span>，让 CLI 读取这个环境变量后访问&nbsp;</span><code style=\"font-family: monospace;\"><span><span>api.anthropic.com</span></span></code><span>。使用 Credential Vault 后，沙箱里可以只设置一个假的&nbsp;</span><code style=\"font-family: monospace;\"><span><span>ANTHROPIC_API_KEY</span></span></code><span>，例如：</span></span></p>\n  </div>\n  <p class=\"code-snippet__fix code-snippet__js\"></p>\n  <ul class=\"code-snippet__line-index code-snippet__js\"></ul>\n  <pre class=\"code-snippet__js\"><code><span><span class=\"code-snippet__attr\">ANTHROPIC_API_KEY</span>=fake-key-inside-sandbox</span></code></pre>\n  <p></p>\n  <div style=\"margin-left: 6px;margin-right: 6px;line-height: 1.75em;\">\n   <p style=\"margin:24px 0px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">这个假值只是为了让 CLI 正常启动。真正的 Anthropic API Key 由宿主侧 SDK 写入 Credential Vault，并绑定到明确的出站请求范围，例如：</span></p>\n   <ul style=\"margin: 1em 0;padding-left: 2em;\" class=\"list-paddingleft-1\">\n    <li style=\"margin-bottom: 0.4em;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span>scheme：</span><code style=\"font-family: monospace;\"><span><span>https</span></span></code></span></p>\n    </li>\n    <li style=\"margin-bottom: 0.4em;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span>host：</span><code style=\"font-family: monospace;\"><span><span>api.anthropic.com</span></span></code></span></p>\n    </li>\n    <li style=\"margin-bottom: 0.4em;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span>port：</span><code style=\"font-family: monospace;\"><span><span>443</span></span></code></span></p>\n    </li>\n    <li style=\"margin-bottom: 0.4em;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span>method：</span><code style=\"font-family: monospace;\"><span><span>GET</span></span></code><span><span>、</span></span><code style=\"font-family: monospace;\"><span><span>POST</span></span></code></span></p>\n    </li>\n    <li style=\"margin-bottom: 0.4em;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span>path：</span><code style=\"font-family: monospace;\"><span><span>/v1/*</span></span></code></span></p>\n    </li>\n    <li style=\"margin-bottom: 0.4em;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span>auth header：</span><code style=\"font-family: monospace;\"><span><span>x-api-key</span></span></code></span></p>\n    </li>\n   </ul>\n   <p style=\"margin:24px 0px 48px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\"><span>当 Claude Code 在沙箱里访问&nbsp;</span><code style=\"font-family: monospace;\"><span><span><a href=\"https://api.anthropic.com/v1/*\" target=\"_blank\">https://api.anthropic.com/v1/*</a></span></span></code><span>时，egress sidecar 会在请求离开沙箱前注入真实的&nbsp;</span><code style=\"font-family: monospace;\"><span><span>x-api-key</span></span></code><span>&nbsp;Header。对 Claude Code 来说，请求可以正常完成；对沙箱进程来说，它从未见过真实密钥。</span></span></p>\n   <p style=\"margin-left: 6px;margin-right: 6px;line-height: 1.75em;\"></p>\n   <h1 class=\"js_darkmode__3\" style=\"font-variant-caps:normal;color:rgb(234, 120, 0);white-space:normal;font-weight:500;font-size:20px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;text-align:center;-webkit-text-stroke-width:0px;padding:0px;margin:48px 8px 0px;visibility:visible;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.8;font-style:normal;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\"><span class=\"js_darkmode__4\" style=\"font-variant-caps:normal;color:rgb(234, 120, 0);font-weight:500;font-size:20px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);margin-left:0px;outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;-webkit-text-stroke-width:0px;padding:0px;visibility:visible;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.8;font-style:normal;margin-right:0px;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\">04</span></h1>\n   <p></p>\n   <p style=\"text-align: center;margin-bottom: 24px;\"><span style=\"color:rgb(234, 120, 0);font-weight:500;letter-spacing:0.544px;font-size:20px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;font-style:normal;\">不只适用于模型 API</span></p>\n   <p style=\"margin:0px 0px 24px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">Credential Vault 也适用于更多常见开发者工具场景。</span></p>\n   <p style=\"margin:24px 0px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\"><span>私有 Git 仓库 clone 可以使用 Basic Auth binding。真实的&nbsp;</span><code style=\"font-family: monospace;\"><span><span>username:token</span></span></code><span>&nbsp;先在宿主侧编码后写入 Vault，沙箱里执行的仍然是普通无密钥 URL：</span></span></p>\n   <p class=\"code-snippet__fix code-snippet__js\"></p>\n   <ul class=\"code-snippet__line-index code-snippet__js\"></ul>\n   <pre class=\"code-snippet__js\"><code><span>GIT_TERMINAL_PROMPT=0 git&nbsp;<span class=\"code-snippet__built_in\">clone</span>&nbsp;<a href=\"https://api.github.com/org/private-repo.git\" target=\"_blank\">https://api.github.com/org/private-repo.git</a></span></code></pre>\n   <p></p>\n   <p style=\"margin:24px 0px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">访问内部 API 时，也可以把 Token 绑定到明确的 Header、Host、Path 和 Method 上。沙箱命令保持干净：</span></p>\n   <p class=\"code-snippet__fix code-snippet__js\"></p>\n   <ul class=\"code-snippet__line-index code-snippet__js\"></ul>\n   <pre class=\"code-snippet__js\"><code><span>curl -fsS <a href=\"https://api.github.com/v1/projects/\" target=\"_blank\">https://api.github.com/v1/projects/</a></span></code></pre>\n   <p></p>\n   <p style=\"margin:24px 0px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">真正的认证信息由 egress sidecar 在出站链路上补齐。这种设计的价值在于，凭据不再是一个进入沙箱后任意可读、任意可复制的字符串，而变成一条受控的出站授权规则。</span></p>\n   <p style=\"margin-left: 6px;margin-right: 6px;line-height: 1.75em;\"></p>\n   <h1 class=\"js_darkmode__3\" style=\"font-variant-caps:normal;color:rgb(234, 120, 0);white-space:normal;font-weight:500;font-size:20px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;text-align:center;-webkit-text-stroke-width:0px;padding:0px;margin:48px 8px 0px;visibility:visible;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.8;font-style:normal;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\"><span class=\"js_darkmode__4\" style=\"font-variant-caps:normal;color:rgb(234, 120, 0);font-weight:500;font-size:20px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);margin-left:0px;outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;-webkit-text-stroke-width:0px;padding:0px;visibility:visible;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.8;font-style:normal;margin-right:0px;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\">05</span></h1>\n   <p></p>\n   <p style=\"text-align: center;margin-bottom: 24px;\"><span style=\"color:rgb(234, 120, 0);font-weight:500;letter-spacing:0.544px;font-size:20px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;font-style:normal;\">更细粒度的安全边界</span></p>\n   <p style=\"margin:0px 0px 24px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">Credential Vault 通常应该和默认拒绝的出站网络策略一起使用。这也就意味着，沙箱默认不能访问任意外部地址，只允许访问工具真正需要的服务 Host，再通过 Credential Vault 将凭据绑定到更窄的请求范围。</span></p>\n   <p style=\"margin:24px 0px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\"><span>例如，对模型 API 可以只允许&nbsp;</span><code style=\"font-family: monospace;\"><span><span>/v1/*</span></span></code><span>；对 Git 仓库可以只绑定某个私有仓库路径；对内部 API 可以限制到具体 Method 和 Path。</span></span></p>\n   <p style=\"margin:24px 0px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">这带来以下几项直接收益：</span></p>\n   <ul style=\"margin: 1em 0;padding-left: 2em;\" class=\"list-paddingleft-1\">\n    <li style=\"margin-bottom:0.4em;color:#888888;font-size:14px;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span style=\"font-size: 14px;color: rgb(136, 136, 136);\">真实密钥不进入沙箱环境；</span></span></p>\n    </li>\n    <li style=\"margin-bottom:0.4em;color:#888888;font-size:14px;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span style=\"font-size: 14px;color: rgb(136, 136, 136);\">密钥不会自然残留在命令行、文件和日志中；</span></span></p>\n    </li>\n    <li style=\"margin-bottom:0.4em;color:#888888;font-size:14px;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span style=\"font-size: 14px;color: rgb(136, 136, 136);\">凭据只能在匹配的出站请求上被使用；</span></span></p>\n    </li>\n    <li style=\"margin-bottom:0.4em;color:#888888;font-size:14px;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span style=\"font-size: 14px;color: rgb(136, 136, 136);\">不同服务、不同路径可以绑定不同凭据；</span></span></p>\n    </li>\n    <li style=\"margin-bottom:0.4em;color:#888888;font-size:14px;\">\n     <p style=\"line-height: 1.6em;margin-bottom: 0px;margin-top: 0px;\"><span style=\"font-size: 15px;\"><span style=\"font-size: 14px;color: rgb(136, 136, 136);\">平台可以更容易审计和收敛凭据使用边界。</span></span></p>\n    </li>\n   </ul>\n   <p style=\"margin:24px 0px 0px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">需要注意的是，Credential Vault 依赖 egress sidecar 的透明出站拦截和 MITM路径。</span></p>\n   <p style=\"margin:24px 0px 48px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">如果 sandbox pod 同时注入 Istio / Envoy 这类透明 service mesh sidecar，两层拦截会在同一个网络命名空间内冲突。OpenSandbox 当前不支持 Credential Vault 与这类透明 service mesh sidecar 同时工作在同一个 sandbox pod 内。</span></p>\n   <p style=\"margin-left: 6px;margin-right: 6px;line-height: 1.75em;\"></p>\n   <h1 class=\"js_darkmode__3\" style=\"font-variant-caps:normal;color:rgb(234, 120, 0);white-space:normal;font-weight:500;font-size:20px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;text-align:center;-webkit-text-stroke-width:0px;padding:0px;margin:48px 8px 0px;visibility:visible;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.8;font-style:normal;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\"><span class=\"js_darkmode__4\" style=\"font-variant-caps:normal;color:rgb(234, 120, 0);font-weight:500;font-size:20px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);margin-left:0px;outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;-webkit-text-stroke-width:0px;padding:0px;visibility:visible;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.8;font-style:normal;margin-right:0px;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\">06</span></h1>\n   <p></p>\n   <p style=\"text-align: center;margin-bottom: 24px;\"><span style=\"color:rgb(234, 120, 0);font-weight:500;letter-spacing:0.544px;font-size:20px;font-family:&quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;font-style:normal;\">从沙箱隔离到凭据隔离</span></p>\n   <p style=\"margin:0px 0px 24px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">沙箱平台过去关注的重点，通常是进程隔离、文件系统隔离、网络隔离和资源隔离。Credential Vault 进一步补上了 AI Agent 生产化过程中的关键一环：凭据隔离。</span></p>\n   <p style=\"margin:24px 0px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">AI Agent 的执行链路往往更长，也更难完全预测。它可能会调用外部 CLI，安装依赖，执行仓库脚本，访问模型 API，甚至被用户输入或网页内容间接影响。如果真实密钥直接暴露给这条链路，风险很难收敛。</span></p>\n   <p style=\"margin:24px 0px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">Credential Vault 给出的答案是：真实密钥应该留在沙箱外，由平台在受控的出站链路上按规则注入。沙箱负责执行，Vault 负责授权，egress policy 负责边界。</span></p>\n   <p style=\"margin:24px 0px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">这让 OpenSandbox 不只是一个“能运行 Agent 的地方”，而是向生产级 Agent Runtime 又推进了一步。</span></p>\n   <p style=\"margin:24px 0px 48px;font-size:15px;line-height:1.6em;\"><span style=\"font-size: 15px;\">一句话总结：Credential Vault 不是让沙箱更方便地保存密钥，而是让沙箱不再需要保存真实密钥。</span></p>\n   <h2 style=\"font-variant-caps:normal;white-space:normal;font-weight:400;font-size:17px;min-height:24px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC NEW&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;text-align:justify;-webkit-text-stroke-width:0px;padding:0px;margin:0px;letter-spacing:0.544px;clear:both;text-decoration-style:initial;line-height:1.75em;font-style:normal;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\"><span style=\"-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;\"><span style=\"-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;\"><span style=\"font-size: 15px;color: rgb(136, 136, 136);font-weight: bold;font-style: italic;\">References</span></span></span></h2>\n   <p style=\"font-variant-caps:normal;white-space:normal;font-weight:400;font-size:17px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC NEW&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;text-align:justify;-webkit-text-stroke-width:0px;padding:0px;margin:0px;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.75em;font-style:normal;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\"><span style=\"-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;\"><span style=\"font-size: 15px;\"><span style=\"color: rgb(136, 136, 136);font-style: italic;\"><span><span style=\"color: rgb(178, 178, 178);font-style: italic;\">[1]</span></span></span><span><span style=\"color: rgb(178, 178, 178);font-style: italic;\">OpenSandbox GitHub</span></span></span></span></p>\n   <p><span style=\"font-size: 15px;\"><span style=\"color: rgb(178, 178, 178);font-style: italic;\"><a href=\"https://github.com/opensandbox-group/OpenSandbox\" target=\"_blank\">https://github.com/opensandbox-group/OpenSandbox</a></span></span></p>\n   <p style=\"font-variant-caps:normal;white-space:normal;font-weight:400;font-size:17px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC NEW&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;text-align:justify;-webkit-text-stroke-width:0px;padding:0px;margin:0px;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.75em;font-style:normal;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\"><span style=\"-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;font-size: 15px;\"><span style=\"color: rgb(178, 178, 178);font-style: italic;\">[2]Credential Vault 文档</span></span></p>\n   <p style=\"font-variant-caps:normal;white-space:normal;font-weight:400;font-size:17px;box-sizing:border-box !important;text-decoration-thickness:initial;overflow-wrap:break-word !important;-webkit-tap-highlight-color:rgba(0, 0, 0, 0);outline:0px;word-spacing:0px;text-indent:0px;font-family:&quot;PingFang SC NEW&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;orphans:2;text-decoration-color:initial;text-align:justify;-webkit-text-stroke-width:0px;padding:0px;margin:0px;letter-spacing:0.544px;text-decoration-style:initial;line-height:1.75em;font-style:normal;text-transform:none;max-width:100%;font-variant-ligatures:normal;widows:2;\"><span style=\"-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;font-size: 15px;\"><span style=\"color: rgb(178, 178, 178);font-style: italic;\"><a href=\"https://github.com/opensandbox-group/OpenSandbox/blob/main/docs/guides/credential-vault.md\" target=\"_blank\">https://github.com/opensandbox-group/OpenSandbox/blob/main/docs/guides/credential-vault.md</a></span></span></p>\n   <div>\n    <div>\n     <div style=\"outline: 0px;letter-spacing: 0.544px;\">\n      <div style=\"margin: 10px auto;outline: 0px;letter-spacing: 0.578px;text-align: center;\">\n       <div style=\"outline: 0px;display: flex;justify-content: center;align-items: center;\"></div>\n      </div>\n     </div>\n    </div>\n   </div>\n  </div>\n  <p style=\"display: none;\"></p>\n </body>\n</html>","edited":true,"updateTime":"2026-06-26T13:43:38.370+00:00"}}}