{"success":true,"code":null,"message":null,"requestId":"T8810ad7ab8654f9888dad571900a3f49","data":{"contentData":{"id":"RAW_7c913b66","displayDocument":"<html>\n <head></head>\n <body>\n  <div id=\"__next\">\n   <div style=\"display:flex;min-height:100vh;flex-flow:column;\">\n    <div class=\"root legacy\">\n     <main>\n      <div id=\"body-container\" style=\"padding:0\" class=\"Container_default-padding__NDTf_ Container_max-width-none__tE5jX Container_container__E6LlX\">\n       <div class=\"Article_ArticleWrapper__U7T_4\">\n        <div id=\"storyline-root\" class=\"Storyline_Root__Al8c8 Storyline_notEmbed__gY6PM Storyline_isLegacy__Ub5nG\">\n         <div class=\"Storyline_NavContainer__t7YOI undefined\">\n          <div class=\"Storyline_TitleWrapper__zPu0y\">\n           <p class=\"Storyline_StorylineTitle__lns7V TypographyVariants_headlineSansBoldExtraSmall__2ww_8 inherit Typography_base__T6j8f\">FIFA World</p>\n           <p class=\"Storyline_StorylineTitle__lns7V TypographyVariants_headlineSansBoldExtraSmall__2ww_8 inherit Typography_base__T6j8f\">Cup 2026</p>\n          </div>\n          <div class=\"Storyline_ItemContainer__AdVct\">\n           <a href=\"https://www.nytimes.com/athletic/live-blogs/panama-vs-croatia-live-updates-world-cup-2026-score-result/e4pNJtNjz2YA/\"> \n            <div class=\"Storyline_StorylineItem__0Bav_\">\n             <p class=\"Storyline_liveBadge__5vYPs TypographyVariants_headlineSansBoldExtraSmall__2ww_8 inherit Typography_base__T6j8f\">LIVE</p>\n             <div class=\"Storyline_ItemTitle__W3Wj_\">Panama vs Croatia</div>\n             <p class=\"Storyline_timestamp__FS9Ee TypographyVariants_utilitySansMediumExtraSmall__NzSVv inherit Typography_base__T6j8f\"><span>33s ago</span></p>\n            </div> \n           </a><a href=\"https://www.nytimes.com/athletic/7376802/2026/06/23/england-ghana-world-cup-result-pickford-foul/\"> \n            <div class=\"Storyline_StorylineItem__0Bav_\">\n             <div class=\"Storyline_ItemTitle__W3Wj_\">England, Ghana Draw</div>\n            </div> \n           </a><a href=\"https://www.nytimes.com/athletic/7386624/2026/06/23/world-cup-weather-england/\"> \n            <div class=\"Storyline_StorylineItem__0Bav_\">\n             <div class=\"Storyline_ItemTitle__W3Wj_\">Weather Watch</div>\n            </div> \n           </a><a href=\"https://www.nytimes.com/athletic/7376801/2026/06/23/cristiano-ronaldo-portugal-uzbekistan-world-cup/\"> \n            <div class=\"Storyline_StorylineItem__0Bav_\">\n             <div class=\"Storyline_ItemTitle__W3Wj_\">Ronaldo's Record-Breaking Win</div>\n            </div> \n           </a><a href=\"https://www.nytimes.com/athletic/interactive/fifa-mens-world-cup-2026-tracker/group-knockout-bracket-projection/\"> \n            <div class=\"Storyline_StorylineItem__0Bav_\">\n             <div class=\"Storyline_ItemTitle__W3Wj_\">Bracket</div>\n            </div> \n           </a><a href=\"https://www.nytimes.com/athletic/7329359/2026/06/23/world-cup-2026-teams-ranked/\"> \n            <div class=\"Storyline_StorylineItem__0Bav_\">\n             <div class=\"Storyline_ItemTitle__W3Wj_\">Re-Ranking The Teams</div>\n            </div> \n           </a><a href=\"https://www.nytimes.com/athletic/interactive/fifa-world-cup-stars-of-soccer-2026/\"> \n            <div class=\"Storyline_StorylineItem__0Bav_\">\n             <div class=\"Storyline_ItemTitle__W3Wj_\">Players to Watch</div>\n            </div> \n           </a><a href=\"https://www.nytimes.com/athletic/7386940/2026/06/23/world-cup-penalty-shootout-rules-coin-toss/\"> \n            <div class=\"Storyline_StorylineItem__0Bav_\">\n             <div class=\"Storyline_ItemTitle__W3Wj_\">Penalty Shootout Rule Change</div>\n            </div> \n           </a>\n          </div>\n         </div>\n        </div>\n        <div class=\"Article_Wrapper__yUEgd article-container\">\n         <div class=\"Article_ArticleHeader__D0qXv\">\n          <div class=\"Article_HeadlineContainer__PR98W\">\n           <div class=\"ArticleLabel_Label__fiJjH\">Analysis</div>\n          </div>\n          <div class=\"Article_ImageContainer__u7w_I article-inline-image\">\n           <div class=\"\">\n            <span style=\"border:0;padding:0;margin:0;overflow:hidden;background:none;display:block;width:initial;box-sizing:border-box;opacity:1;height:initial;\"><span style=\"box-sizing:border-box;display:block;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;padding-top:66.66666666666666%\"></span><img alt=\"Behind the net image of Algeria scoring against Jordan\" fetchpriority=\"high\" sizes=\"\n  (max-width: 600px) 100vw,\n  (max-width: 1000px) 90vw,\n  674px\n\" srcset=\"https://static01.nyt.com/athletic/uploads/wp/2026/06/23082814/GettyImages-2282876783-1024x650.jpg?width=600&amp;quality=70&amp;auto=webp 600w, https://static01.nyt.com/athletic/uploads/wp/2026/06/23082814/GettyImages-2282876783-1024x650.jpg?width=770&amp;quality=70&amp;auto=webp 770w, https://static01.nyt.com/athletic/uploads/wp/2026/06/23082814/GettyImages-2282876783-1024x650.jpg?width=1000&amp;quality=70&amp;auto=webp 1000w, https://static01.nyt.com/athletic/uploads/wp/2026/06/23082814/GettyImages-2282876783-1024x650.jpg?width=1248&amp;quality=70&amp;auto=webp 1248w, https://static01.nyt.com/athletic/uploads/wp/2026/06/23082814/GettyImages-2282876783-1024x650.jpg?width=1440&amp;quality=70&amp;auto=webp 1440w, https://static01.nyt.com/athletic/uploads/wp/2026/06/23082814/GettyImages-2282876783-1024x650.jpg?width=1920&amp;quality=70&amp;auto=webp 1920w\" src=\"https://static01.nyt.com/athletic/uploads/wp/2026/06/23082814/GettyImages-2282876783-1024x650.jpg?width=1920&amp;quality=70&amp;auto=webp\" decoding=\"async\" data-nimg=\"responsive\" class=\"image-next-root\" style=\"border:none;border-bottom-left-radius:0px;padding:0;max-height:100%;margin:auto;bottom:0;display:block;object-fit:cover;border-top-right-radius:0px;min-height:100%;right:0;box-sizing:border-box;top:0;max-width:100%;left:0;border-top-left-radius:0px;border-bottom-right-radius:0px;\"></span>\n           </div>\n           <p class=\"Article_ImageCaptionCredit__wtmKL article-image-caption-credit inherit Typography_base__T6j8f\">Austria will play Algeria in the final group game on Saturday to determine who finishes second and third in Group J<!-- --> <span class=\"Article_ImageCredit__2YNda inherit Typography_base__T6j8f\">Stu Forster/Getty Images</span></p>\n          </div>\n          <div style=\"width:100%\">\n           <div class=\"Grid_container__nUoFL Grid_alignItems-center__gLeMH Grid_justifyContent-flex-start__c8ll5 Grid_xsNumber12__7AIjd Article_BylineGrid__hfa8O Article_nonFeatured__wkbrm\">\n            <div class=\"Grid_item__tf6ss Grid_container__nUoFL Grid_flexDirection-row__Wh_h_ Grid_alignItems-center__gLeMH Grid_justifyContent-flex-start__c8ll5 Grid_xsNumber12__7AIjd Grid_smNumber12__I_Kn3\">\n             <div class=\"Article_BylineAuthorWrapper__fdh9N\">\n              <div class=\"Grid_container__nUoFL Grid_flexDirection-row__Wh_h_ Grid_alignItems-stretch__tvoyw Grid_justifyContent-flex-start__c8ll5 Article_AuthorAvatars__S3C8E\">\n               <div class=\"Grid_item__tf6ss Grid_alignItems-stretch__tvoyw Grid_justifyContent-flex-start__c8ll5\">\n                <a href=\"https://www.nytimes.com/athletic/author/colin-millar/\"> \n                 <div class=\"Article_AuthorAvatarImage___6FAx Image_Root--centered__66MeR\">\n                  <span style=\"border:0;padding:0;margin:0;overflow:hidden;max-width:100%;background:none;display:inline-block;width:initial;box-sizing:border-box;opacity:1;height:initial;\"><span style=\"box-sizing:border-box;display:block;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;max-width:100%\"></span><img alt=\"Colin Millar\" src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\" decoding=\"async\" data-nimg=\"intrinsic\" class=\"image-next-root\" style=\"border:none;border-bottom-left-radius:20px;padding:0;max-height:100%;margin:auto;bottom:0;display:block;object-fit:cover;border-top-right-radius:20px;min-height:100%;right:0;box-sizing:border-box;top:0;max-width:100%;left:0;border-top-left-radius:20px;border-bottom-right-radius:20px;\"></span>\n                 </div> \n                </a>\n               </div>\n              </div>\n              <span class=\"Article_BylineString__WkHIP\" id=\"articleByLineString\">By <a href=\"https://www.nytimes.com/athletic/author/colin-millar/\"><u>Colin Millar</u></a></span>\n             </div>\n            </div>\n            <div class=\"Article_BylineTimestamp__KhutQ\">\n             <time datetime=\"2026-06-23T20:32:17.000Z\">June 23, 2026<span class=\"\"><span class=\"FullTimestamp_VerticalLine__r39is\"></span> Updated 4:32 pm EDT</span></time>\n            </div>\n            <div class=\"Grid_container__nUoFL Grid_alignItems-stretch__tvoyw Grid_justifyContent-flex-start__c8ll5 Article_ArticleBylineSocialStandardArticle__e33UI Article_ArticleBylineSocialContainer__1xQ3r\">\n             <div>\n              <div class=\"ShimmerButtonWrapper_AnimationAnchor__oylV_\">\n               <div class=\"ShimmerButtonWrapper_ShimmerWrapper__cSvdw\">\n                <span class=\"ShimmerButtonWrapper_ShimmerButtonLayer__w3NR7\"> \n                 <div>\n                  <button type=\"button\" aria-label=\"Open share menu\" class=\"Pill_Pill__AIU_i ShareMenuDropdown_shareMenuPill__yADnr ShareMenu_ShareButton__yffzG\" aria-pressed=\"false\"><span class=\"Pill_PillLabel__59Ozm\">Share article</span></button>\n                 </div> \n                </span>\n               </div>\n              </div>\n             </div>\n            </div>\n           </div>\n          </div>\n         </div>\n         <div id=\"article-container-grid\" class=\"Article_ContainerGrid__fjaTe\">\n          <div class=\"Article_ContentContainer__jBNW3 article-content-container bodytext1\">\n           <p><i><span>The Athletic has live coverage of </span></i><a href=\"https://www.nytimes.com/athletic/live-blogs/panama-vs-croatia-live-updates-world-cup-2026-score-result/e4pNJtNjz2YA/\"><i><span>Panama vs Croatia</span></i></a><i><span> at the </span></i><a href=\"https://www.nytimes.com/athletic/live-blogs/panama-vs-croatia-live-updates-world-cup-2026-score-result/e4pNJtNjz2YA/\"><i><span>2026 FIFA World Cup.</span></i></a></p>\n           <p>The World Cup group stage is not yet complete, but the knockout phase is already taking shape. Nations will be turning one eye to last-32 pairings and plotting possible pathways to the tournament’s latter stages.</p>\n           <p>The expanded 48-team format <a href=\"https://www.nytimes.com/athletic/7381556/2026/06/22/fifa-group-rules-third-fourth-place-head-to-head-quirk/\">creates complications</a>; eight of the 12 group third-place finishers will advance to the knockouts. Each of these sides will face a group winner, but four additional group winners will play a group runner-up.</p>\n           <div class=\"ad-container\">\n            <div class=\"ad-wrapper article-treatment\">\n             <div class=\"ad-slug-container\">\n              <p class=\"ad-slug\">Advertisement</p>\n             </div>\n            </div>\n           </div>\n           <p>Those groups have already been locked into the draw — Group C (which includes Brazil and Morocco) is paired with Group F (where the Netherlands and Japan are the top two with one game left), while the other pairing is between Group H and Group J.</p>\n           <ul>\n            <li><a href=\"https://www.nytimes.com/athletic/interactive/fifa-mens-world-cup-2026-tracker/group-knockout-bracket-projection/\"><em>Check out </em>The Athletic<em>’s interactive forecast for the round-of-32 bracket</em></a></li>\n           </ul>\n           <p>Spain will confirm their status as Group H winners if they defeat Uruguay on Friday, with a draw almost certainly being enough (Cape Verde would have to defeat Saudi Arabia by at least four goals to overtake them in this scenario).</p>\n           <p>Defending champions Argentina have already secured top spot in Group J and will face the Group H runners-up. Jordan have been eliminated from Group J and will finish fourth, with Austria and Algeria level on three points each.</p>\n           <p>Austria will play Algeria in their final Group J game on Saturday in Kansas City. Austria hold a superior goal difference, so a draw or a win would clinch second spot for Ralf Rangnick’s side, while Algeria need to win to advance in second.</p>\n           <p>However, this raises one question: would finishing third in these groups (with a points tally and goal difference sufficient to advance) hand those nations a more favourable draw?</p>\n           <p><img class=\"alignnone size-full wp-image-7386727\" src=\"https://static01.nyt.com/athletic/uploads/wp/2026/06/23115645/Screenshot-2026-06-23-at-16.56.36.png\" alt=\"\">\n            <br>\n            Nobody will want to face Spain and Argentina, the champions of Europe and South America, especially so early in the tournament.</p>\n           <p id=\"article-pickem\"></p>\n           <p>If Austria or Algeria finish third in Group J and advance, their pathway will be rather different. Instead of a likely match-up with Spain, they would face one of the United States, the winner of Group B (Canada or Switzerland), the winner of Group G (Egypt, Iran or Belgium), the winner of Group L (England, Ghana, Croatia or Panama), or the winner of Group K (Colombia, DR Congo, Portugal or Uzbekistan).</p>\n           <p>England and Portugal may be among the tournament favourites, and <a href=\"https://www.nytimes.com/athletic/7377954/2026/06/20/usmnt-win-world-cup-prediction/\">the U.S. have been one of the standout sides</a>, but there is a compelling argument that finishing third in Group J could hand Algeria or Austria a more favourable draw.</p>\n           <div class=\"ad-container\">\n            <div class=\"ad-wrapper article-treatment\">\n             <div class=\"ad-slug-container\">\n              <p class=\"ad-slug\">Advertisement</p>\n             </div>\n            </div>\n           </div>\n           <p><a href=\"https://www.nytimes.com/athletic/6865312/2025/12/05/world-cup-2026-hardest-easiest-groups-golden-boot/\">Imbalanced pathways and the luck of the draw</a> have always existed in international tournaments, but third-place teams advancing throws an extra element of fortune into the draw.</p>\n           <hr>\n           <h2><strong>Why are third group games played at the same time?</strong></h2>\n           <p>Since the 1986 World Cup, the final pairs of group matches have always started simultaneously.</p>\n           <p>This was introduced to prevent teams from holding an unfair advantage on the final matchday by playing later than their group rivals. In the previous World Cup, in 1982, West Germany defeated Austria 1-0 after Algeria had defeated Chile in their final group game.</p>\n           <p>It was established before the final game that a West Germany win by one or two goals would qualify both teams and eliminate Algeria, but any other result would eliminate Austria or West Germany.</p>\n           <div id=\"attachment_7386092\" class=\"wp-caption alignnone\">\n            <div class=\"wp-caption-image-container\">\n             <img loading=\"lazy\" class=\"wp-image-7386092 size-full\" src=\"https://static01.nyt.com/athletic/uploads/wp/2026/06/23083319/GettyImages-989875704-scaled.jpg\" alt=\"West Germany scoring against Austria at World Cup 1982\" srcset=\"https://static01.nyt.com/athletic/uploads/wp/2026/06/23083319/GettyImages-989875704-scaled.jpg 2560w, https://static01.nyt.com/athletic/uploads/wp/2026/06/23083319/GettyImages-989875704-300x198.jpg 300w, https://static01.nyt.com/athletic/uploads/wp/2026/06/23083319/GettyImages-989875704-1024x675.jpg 1024w, https://static01.nyt.com/athletic/uploads/wp/2026/06/23083319/GettyImages-989875704-1536x1013.jpg 1536w, https://static01.nyt.com/athletic/uploads/wp/2026/06/23083319/GettyImages-989875704-2048x1351.jpg 2048w\" sizes=\"(max-width: 2560px) 100vw, 2560px\">\n             <div class=\"inline-credits\">\n              <div class=\"inline-credits-container\">\n               <span class=\"credits-text\">West Germany’s win over Austria in 1982 gained notoriety and prompted a format change (Werek/picture alliance via Getty Images)</span>\n              </div>\n             </div>\n            </div>\n           </div>\n           <p>West Germany scored in the 10th minute and for the remaining 80 minutes, there were few attacks from either team. Each team knew the result was mutually beneficial for their progression.</p>\n           <p>The match became known as the ‘<a href=\"https://www.nytimes.com/athletic/5592814/2024/06/26/disgrace-of-gijon-world-cup/\">Disgrace of Gijon</a>’, after the Spanish city in which it was contested.</p>\n           <p>FIFA subsequently revised the group system for future tournaments so that the final two games in each group would be played simultaneously to help prevent similar scenarios.</p>\n           <hr>\n           <h2><strong>Which third-place teams advance in this tournament?</strong></h2>\n           <p>The eight highest-ranked third-place teams from the 12 groups will advance, with group points won the first factor considered. If points are equal, goal difference will be used to determine rankings and if this is the same, then the team with the most goals scored will rank higher.</p>\n           <p>If any teams are still tied after these criteria are applied, then the team with the best ‘fair play’ disciplinary record — ie, the fewest yellow and red cards — will be used.</p>\n           <p>A yellow card counts for one point, an indirect red card (resulting from a second yellow card) is three points, a direct red is four points and a yellow plus a direct red card is five points. The team with the lowest points has the best ‘fair play’ score.</p>\n           <div id=\"inline-graphic\">\n            <ignore> <a id=\"showcase-link-7338230\" href=\"https://www.nytimes.com/athletic/7338230/2026/06/06/world-cup-group-stage-teams-third-place/\" class=\"showcase-link-container in-content-module-link testbed-shortcode\" data-shortcode-id=\"101\" data-shortcode-string=\"showcase-link\" data-content-id=\"7338230\" data-content-post-type=\"headline\"> \n              <div class=\"showcase-link\">What You Should Read Next</div> \n              <div class=\"showcase-link-inner-content\">\n               <img src=\"https://static01.nyt.com/athletic/uploads/wp/2026/06/06104920/GettyImages-2250192150-1024x683.jpg?width=400&amp;quality=70\" alt=\"World Cup 2026 group stage explained: How teams can qualify for the knockout stage\" class=\"showcase-link-image\" loading=\"lazy\">\n               <div class=\"showcase-link-text-content\">\n                <div class=\"showcase-link-title\">World Cup 2026 group stage explained: How teams can qualify for the knockout stage</div>\n                <div class=\"showcase-link-excerpt\">For the first time, FIFA is using head-to-head records instead of group goal difference as the primary tiebreaker for teams level on points.</div>\n               </div>\n              </div> \n             </a> </ignore>\n           </div>\n           <p>If these numbers are the same for different teams, the side with the higher FIFA world ranking edges the tiebreak.</p>\n           <p>All 12 nations who rank fourth in their group will be automatically eliminated.</p>\n           <div class=\"ad-container\">\n            <div class=\"ad-wrapper article-treatment\">\n             <div class=\"ad-slug-container\">\n              <p class=\"ad-slug\">Advertisement</p>\n             </div>\n            </div>\n           </div>\n           <hr>\n           <h2><strong>What has been confirmed?</strong></h2>\n           <p>Mexico, United States, Argentina and Germany have all been confirmed as winners of their groups, and Norway and France have also advanced from Group I — the two will face off on Friday to determine who finishes first and second.</p>\n           <p>Four nations — Haiti, Turkey, Tunisia and Jordan — will all finish fourth in their respective groups and will not advance to the last-32 stage.</p>\n           <div id=\"inline-graphic\" class=\"article-fullwidth\">\n            <div class=\"recirc-article-padding\">\n             <div class=\"recirc-article\">\n              <div class=\"recirc-article-block-title\">World Cup Tracker</div>\n              <div class=\"recirc-article-block-container\">\n               <a class=\"recirc-article-block-article\" href=\"https://www.nytimes.com/athletic/interactive/fifa-mens-world-cup-2026-tracker/\" id=\"recirc-undefined-0\"> <img class=\"recirc-article-image\" src=\"https://static01.nyt.com/athletic/uploads/wp/2026/06/08172940/Standings.png \" alt=\"Groups and standings\"> \n                <div>\n                 <div class=\"recirc-article-block-article-title\">Groups and standings</div>\n                </div> </a> <a class=\"recirc-article-block-article\" href=\"https://www.nytimes.com/athletic/interactive/fifa-mens-world-cup-2026-tracker/group-knockout-bracket-projection/\" id=\"recirc-undefined-1\"> <img class=\"recirc-article-image\" src=\"https://static01.nyt.com/athletic/uploads/wp/2026/06/08173907/Bracket.png\" alt=\"Bracket forecast\"> \n                <div>\n                 <div class=\"recirc-article-block-article-title\">Bracket forecast</div>\n                </div> </a> <a class=\"recirc-article-block-article\" href=\"https://www.nytimes.com/athletic/interactive/fifa-mens-world-cup-2026-tracker/schedule-scores-results/\" id=\"recirc-undefined-2\"> <img class=\"recirc-article-image\" src=\"https://static01.nyt.com/athletic/uploads/wp/2026/06/08173338/Schedule.png\" alt=\"Tournament schedule, scores and results\"> \n                <div>\n                 <div class=\"recirc-article-block-article-title\">Tournament schedule, scores and results</div>\n                </div> </a> <a class=\"recirc-article-block-article\" href=\"https://www.nytimes.com/athletic/interactive/fifa-mens-world-cup-2026-tracker/group-knockout-team-by-team-forecast/\" id=\"recirc-undefined-3\"> <img class=\"recirc-article-image\" src=\"https://static01.nyt.com/athletic/uploads/wp/2026/06/08173532/Forecast.png\" alt=\"Forecasts for all 48 teams\"> \n                <div>\n                 <div class=\"recirc-article-block-article-title\">Forecasts for all 48 teams</div>\n                </div> </a>\n              </div>\n             </div>\n            </div>\n           </div>\n          </div>\n          <div class=\"PuzzleEntryPoint_PuzzleContainer__eVJWr\">\n           <div>\n            <div class=\"PuzzleEntryPoint_PuzzlesContentContainer__tN8KR Content_EaseHover__ZAPW_\">\n             <div class=\"PuzzleEntryPoint_PuzzlesDesktopIconContainer__n6Lyn\">\n              <div class=\"PuzzleEntryPoint_Hidden__uLL_n\">\n               <img src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNiIgaGVpZ2h0PSIxMCIgdmlld0JveD0iMCAwIDI0IDI0IiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPgo8cGF0aCBkPSJNMjQgMS45NTU1OUwxMC41MjQ3IDIxTDAgMTMuMjczTDEuOTYwMzEgMTAuNTUyTDkuNzY2NDggMTYuMjgzMUwyMS4yODc5IDBMMjQgMS45NTU1OVoiIGZpbGw9IiMwMDAwMDAiPjwvcGF0aD4KPC9zdmc+Cg==\">\n              </div>\n              <img class=\"PuzzleEntryPoint_PuzzlesIcon__Po_hP\" src=\"data:image/png;base64,\" alt=\"Connections: Sports Edition Logo\">\n             </div>\n             <div class=\"PuzzleEntryPoint_PuzzlesInfo__luybk\">\n              <div class=\"PuzzleEntryPoint_PuzzlesMobileIconContainer__eN6zD\">\n               <img class=\"PuzzleEntryPoint_PuzzlesIcon__Po_hP\" src=\"data:image/png;base64,\" alt=\"Connections: Sports Edition Logo\">\n              </div>\n              <div class=\"PuzzleEntryPoint_PuzzlesInfoText__flCtO\">\n               <div class=\"PuzzleEntryPoint_PuzzleTopRow__7VsFw\">\n                <time class=\"PuzzleEntryPoint_PuzzlesDate__xHoZn\">Jun 23, 2026</time>\n               </div>\n               <h2 class=\"PuzzleEntryPoint_PuzzlesTitle__s28US\">Connections: Sports Edition</h2>\n               <p class=\"PuzzleEntryPoint_PuzzlesMobileSubtitle__BhT5j\">Spot the pattern. Connect the terms</p>\n               <p class=\"PuzzleEntryPoint_PuzzlesDesktopSubtitle__cgpmH\">Find the hidden link between sports terms</p>\n              </div>\n              <button class=\"PuzzleEntryPoint_PuzzlesButton__eju6v\">\n               <p class=\"PuzzleEntryPoint_PuzzlesButtonText__PsrSe\">Play today's puzzle</p>\n               <svg style=\"font-size:16px;vertical-align:middle\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                <path d=\"M4.79999 12.08L8.8711 8.00002L4.79999 3.92002L6.05332 2.66669L11.3867 8.00002L6.05332 13.3334L4.79999 12.08Z\" fill=\"#121212\"></path>\n               </svg>\n              </button>\n             </div>\n            </div>\n           </div>\n          </div>\n         </div>\n        </div>\n       </div>\n      </div>\n     </main>\n    </div>\n   </div>\n  </div>\n </body>\n</html>","edited":null,"updateTime":"2026-06-24T00:19:09.077+00:00"}}}