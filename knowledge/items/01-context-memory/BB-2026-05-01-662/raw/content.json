      <div class=\"column has-text-centered\">\n          <div class=\"card\">\n           <div class=\"image-container portrait-3-4\">\n            <img src=\"https://hustvl.github.io/Moebius/image_assets/xiao_v41/20240712_pic_1122_masked_gt.3-4.png\" class=\"original-image\" alt=\"\"> <img src=\"https://hustvl.github.io/Moebius/image_assets/xiao_v41/20240712_pic_1122_ours1.3-4.png\" class=\"hover-image\" alt=\"\">\n           </div>\n          </div>\n         </div>\n        </div>\n        <div class=\"columns fixed-center-columns\">\n         <div class=\"column has-text-centered\">\n          <div class=\"card\">\n           <div class=\"image-container portrait-3-4\">\n            <img src=\"https://hustvl.github.io/Moebius/image_assets/xiao_v41/20240712_pic_525_masked_gt.3-4.png\" class=\"original-image\" alt=\"\"> <img src=\"https://hustvl.github.io/Moebius/image_assets/xiao_v41/20240712_pic_525_ours1.3-4.png\" class=\"hover-image\" alt=\"\">\n           </div>\n          </div>\n         </div>\n         <div class=\"column has-text-centered\">\n          <div class=\"card\">\n           <div class=\"image-container portrait-3-4\">\n            <img src=\"https://hustvl.github.io/Moebius/image_assets/xiao_v41/20240712_pic_596_masked_gt.3-4.png\" class=\"original-image\" alt=\"\"> <img src=\"https://hustvl.github.io/Moebius/image_assets/xiao_v41/20240712_pic_596_ours1.3-4.png\" class=\"hover-image\" alt=\"\">\n           </div>\n          </div>\n         </div>\n         <div class=\"column has-text-centered\">\n          <div class=\"card\">\n           <div class=\"image-container portrait-3-4\">\n            <img src=\"https://hustvl.github.io/Moebius/image_assets/xiao_v41/20240712_pic_1189_masked_gt.3-4.png\" class=\"original-image\" alt=\"\"> <img src=\"https://hustvl.github.io/Moebius/image_assets/xiao_v41/20240712_pic_1189_ours1.3-4.png\" class=\"hover-image\" alt=\"\">\n           </div>\n          </div>\n         </div>\n        </div>\n        <