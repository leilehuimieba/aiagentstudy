# 复制本文件为 .env，填入真实值，不要提交 .env 到 git

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的真实key

# 日常任务（摘要/问答/分类）：快速低成本
QA_MODEL=deepseek-v4-flash
SUMMARY_MODEL=deepseek-v4-flash

# 复杂推理任务（矛盾检测/深度分析）：推理模型
REASONING_MODEL=deepseek-v4-pro

COLLECT_QUALITY_THRESHOLD=6

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
MAX_REQUEST_BYTES=1048576

# 如果要把服务暴露给局域网/公网，必须设置随机长 token。
# 管理类接口需要请求头：X-Admin-Token: <ADMIN_TOKEN>
ADMIN_TOKEN=
